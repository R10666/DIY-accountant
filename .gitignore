# Node and Vite
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Python environments and cache
backend/venv/
**/__pycache__/
*.pyc

# Personal Data and Uploads (CRITICAL)
backend/finance.db
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log

# Environment variables
# NOTE: .env itself is intentionally NOT ignored — frontend/.env holds
# the committed public default (VITE_STORAGE_MODE=local) that needs to
# ship with the repo. .env.local is your personal override and stays
# ignored, same for any .env.<mode>.local file.
.env.local
.env.*.local

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db